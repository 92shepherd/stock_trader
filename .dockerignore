# Docker build context exclusions
# Keep the context tiny so `docker compose build` is fast and the image
# never accidentally ships secrets, data files, or local-only state.

# Secrets & local config
.env
.env.local
.env.*.local

# DB volumes (HUGE — would balloon the context to GBs)
data/pgdata/
data/logs/
data/kis/
docs_cache/

# Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.Python

# Virtualenvs
.venv/
venv/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git (not needed at build time)
.git/
.gitignore
.gitattributes

# Notebooks & local tests (not needed in the runtime image)
tests/local/
**/*.ipynb
.ipynb_checkpoints/

# Build outputs
dist/
build/

# Logs
*.log

# Docker artifacts (don't recurse into our own context)
Dockerfile
docker-compose*.yml
.dockerignore

# Misc large files we don't need in the image
*.parquet
*.duckdb
*.pkl

# Project docs not needed at runtime
docs/
