{
  "info": {
    "name": "KIS Open API",
    "_postman_id": "kis-open-api-v1",
    "description": "한국투자증권 Open API (KIS OpenAPI) 컬렉���.\n\n**환경 설정:**\n- `baseUrl`: 모의 `https://openapivts.koreainvestment.com:29443` / 실전 `https://openapi.koreainvestment.com:9443`\n- `mode`: `paper` 또는 `real` (TR_ID 자동 선택)\n- 인증 → 토큰 발급 요청을 먼저 실행하면 `accessToken` 이 자동으로 저장됩니다.\n\n**Rate Limit:**\n- 실전: 초당 20건\n- 모의: 초당 5건",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "https://openapivts.koreainvestment.com:29443", "type": "string" },
    { "key": "appKey",         "value": "YOUR_APP_KEY",    "type": "string" },
    { "key": "appSecret",      "value": "YOUR_APP_SECRET", "type": "string" },
    { "key": "accessToken",    "value": "",                "type": "string" },
    { "key": "accountNo",      "value": "YOUR_ACCOUNT_NO", "type": "string", "description": "계좌번호 앞 8자리 (예: 50123456)" },
    { "key": "accountProduct", "value": "01",              "type": "string", "description": "계좌상품코드" },
    { "key": "mode",           "value": "paper",           "type": "string", "description": "paper 또는 real — TR_ID 자동 분기에 사용" },
    { "key": "symbol",         "value": "005930",          "type": "string", "description": "기본 종목코드 (삼성전자)" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// mode 에 따라 계좌 관련 TR_ID 자동 설정",
          "const mode = pm.collectionVariables.get('mode') || 'paper';",
          "const ids = mode === 'real' ? {",
          "  balance:    'TTTC8434R',",
          "  psblOrder:  'TTTC8908R',",
          "  orderBuy:   'TTTC0802U',",
          "  orderSell:  'TTTC0801U',",
          "  orderChg:   'TTTC0803U',",
          "  dailyCcld:  'TTTC8001R',",
          "  profitLoss: 'TTTC8708R'",
          "} : {",
          "  balance:    'VTTC8434R',",
          "  psblOrder:  'VTTC8908R',",
          "  orderBuy:   'VTTC0802U',",
          "  orderSell:  'VTTC0801U',",
          "  orderChg:   'VTTC0803U',",
          "  dailyCcld:  'VTTC8001R',",
          "  profitLoss: 'VTTC8708R'",
          "};",
          "Object.entries(ids).forEach(([k, v]) => pm.collectionVariables.set('tr_' + k, v));"
        ]
      }
    }
  ],
  "item": [

    {
      "name": "1. 인증 (Authentication)",
      "item": [
        {
          "name": "토큰 발급 (tokenP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.access_token) {",
                  "    pm.collectionVariables.set('accessToken', body.access_token);",
                  "    console.log('accessToken saved. expires_in:', body.expires_in, 's');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json; charset=utf-8" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"appkey\": \"{{appKey}}\",\n  \"appsecret\": \"{{appSecret}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/oauth2/tokenP", "host": ["{{baseUrl}}"], "path": ["oauth2", "tokenP"] },
            "description": "OAuth2 Bearer 토큰 발급. 유효기간 24시간.\n응답의 access_token 이 collectionVariable 에 자동 저장됩니다."
          }
        },
        {
          "name": "토큰 폐기 (revokeP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json; charset=utf-8" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appkey\": \"{{appKey}}\",\n  \"appsecret\": \"{{appSecret}}\",\n  \"token\": \"{{accessToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/oauth2/revokeP", "host": ["{{baseUrl}}"], "path": ["oauth2", "revokeP"] },
            "description": "발급된 토큰 ���시 폐기."
          }
        },
        {
          "name": "해시키 생성 (hashkey)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json; charset=utf-8" },
              { "key": "appkey",      "value": "{{appKey}}" },
              { "key": "appsecret",   "value": "{{appSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CANO\": \"{{accountNo}}\",\n  \"ACNT_PRDT_CD\": \"{{accountProduct}}\",\n  \"OVRS_EXCG_CD\": \"SHAA\",\n  \"PDNO\": \"00001\",\n  \"ORD_QTY\": \"500\",\n  \"OVRS_ORD_UNPR\": \"52.65\",\n  \"CTAC_TLNO\": \"\",\n  \"MGCO_APTM_ODNO\": \"\",\n  \"ORD_SVR_DVSN_CD\": \"0\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/uapi/hashkey", "host": ["{{baseUrl}}"], "path": ["uapi", "hashkey"] },
            "description": "POST 주문 body 의 무결성 검증용 해시키 생성.\n주문 요청 시 `hashkey` 헤더에 이 값을 포함해야 함."
          }
        }
      ]
    },

    {
      "name": "2. 시세 — 국내주식 (Quotations)",
      "item": [
        {
          "name": "주식현재가 시세 (inquire-price)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "FHKST01010100" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/quotations/inquire-price?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD={{symbol}}",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "quotations", "inquire-price"],
              "query": [
                { "key": "FID_COND_MRKT_DIV_CODE", "value": "J", "description": "J=주식/ETF/ETN" },
                { "key": "FID_INPUT_ISCD",          "value": "{{symbol}}" }
              ]
            },
            "description": "TR_ID: FHKST01010100\n\n종목 현재가 스냅샷. 시총/PER/PBR/EPS/외국인보유비율 등 포함.\n\n주요 응답 필드 (output):\n- stck_prpr: 현재가\n- acml_vol: 누적거래량\n- hts_avls: 시가총액(억원)\n- per, pbr, eps\n- hts_frgn_ehrt: 외국인보유비율\n- frgn_ntby_qty: 외국인순매수수량"
          }
        },
        {
          "name": "기간별 시세 — 일봉 수정주가 (inquire-daily-itemchartprice)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "FHKST03010100" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/quotations/inquire-daily-itemchartprice?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD={{symbol}}&FID_INPUT_DATE_1=20260101&FID_INPUT_DATE_2=20260517&FID_PERIOD_DIV_CODE=D&FID_ORG_ADJ_PRC=0",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "quotations", "inquire-daily-itemchartprice"],
              "query": [
                { "key": "FID_COND_MRKT_DIV_CODE", "value": "J" },
                { "key": "FID_INPUT_ISCD",          "value": "{{symbol}}" },
                { "key": "FID_INPUT_DATE_1",         "value": "20260101", "description": "시작일 YYYYMMDD" },
                { "key": "FID_INPUT_DATE_2",         "value": "20260517", "description": "종료일 YYYYMMDD" },
                { "key": "FID_PERIOD_DIV_CODE",      "value": "D",        "description": "D=일 W=주 M=월 Y=년" },
                { "key": "FID_ORG_ADJ_PRC",          "value": "0",        "description": "0=수정주가 1=원주가" }
              ]
            },
            "description": "TR_ID: FHKST03010100 (실전/모의 공통)\n\n기간별 OHLCV 조회. 최대 100 영업일/호출.\n수정주가 반영(FID_ORG_ADJ_PRC=0) — daily_prices 테이블 소스.\n\n주요 응답 필드 (output2 list):\n- stck_bsop_date: 영업일 YYYYMMDD\n- stck_oprc/hgpr/lwpr/clpr: OHLC\n- acml_vol: 누적거래량\n- acml_tr_pbmn: 누적거래대금"
          }
        },
        {
          "name": "기간별 시세 — 일봉 원주가 (inquire-daily-itemchartprice)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "FHKST03010100" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/quotations/inquire-daily-itemchartprice?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD={{symbol}}&FID_INPUT_DATE_1=20260101&FID_INPUT_DATE_2=20260517&FID_PERIOD_DIV_CODE=D&FID_ORG_ADJ_PRC=1",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "quotations", "inquire-daily-itemchartprice"],
              "query": [
                { "key": "FID_COND_MRKT_DIV_CODE", "value": "J" },
                { "key": "FID_INPUT_ISCD",          "value": "{{symbol}}" },
                { "key": "FID_INPUT_DATE_1",         "value": "20260101" },
                { "key": "FID_INPUT_DATE_2",         "value": "20260517" },
                { "key": "FID_PERIOD_DIV_CODE",      "value": "D" },
                { "key": "FID_ORG_ADJ_PRC",          "value": "1", "description": "1=원주가(수정 미반영)" }
              ]
            },
            "description": "TR_ID: FHKST03010100\n\nFID_ORG_ADJ_PRC=1 로 원주가 조회 — daily_prices_raw 테이블 소스."
          }
        },
        {
          "name": "당일 분봉 (inquire-time-itemchartprice)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "FHKST03010200" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/quotations/inquire-time-itemchartprice?FID_ETC_CLS_CODE=&FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD={{symbol}}&FID_INPUT_HOUR_1=153000&FID_PW_DATA_INCU_YN=N",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "quotations", "inquire-time-itemchartprice"],
              "query": [
                { "key": "FID_ETC_CLS_CODE",       "value": "" },
                { "key": "FID_COND_MRKT_DIV_CODE", "value": "J" },
                { "key": "FID_INPUT_ISCD",          "value": "{{symbol}}" },
                { "key": "FID_INPUT_HOUR_1",        "value": "153000", "description": "기준시각 HHMMSS — 이 시각 이전 30봉 반환" },
                { "key": "FID_PW_DATA_INCU_YN",    "value": "N",      "description": "N=당일만 Y=업종 이전시간 포함(개별종목 과거날짜 불가)" }
              ]
            },
            "description": "TR_ID: FHKST03010200 (실전/모의 공통)\n\n⚠️ 당일 데이터만 지원. 과거 날짜 조회 불가.\n\n1회 최대 30봉. 하루치(390봉) 수집 시 FID_INPUT_HOUR_1 을 역방향으로 이동하며 ~13회 호출.\n\n주요 응답 필드 (output2 list):\n- stck_bsop_date: 영업일 YYYYMMDD\n- stck_cntg_hour: 체결시각 HHMMSS\n- stck_prpr: 현재가(close)\n- stck_oprc/hgpr/lwpr: OHL\n- cntg_vol: 체결거래량(해당봉)\n- acml_vol: 누적거래량\n- acml_tr_pbmn: 누적거래대금"
          }
        },
        {
          "name": "호가 (inquire-asking-price-exp-ccn)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "FHKST01010200" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/quotations/inquire-asking-price-exp-ccn?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD={{symbol}}",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "quotations", "inquire-asking-price-exp-ccn"],
              "query": [
                { "key": "FID_COND_MRKT_DIV_CODE", "value": "J" },
                { "key": "FID_INPUT_ISCD",          "value": "{{symbol}}" }
              ]
            },
            "description": "TR_ID: FHKST01010200\n\n매도/매�� 호가 10단계 + 예상체결가 조회.\n\n주요 응답 필드 (output1):\n- askp1~10: 매도호가 1~10\n- bidp1~10: 매수호가 1~10\n- askp_rsqn1~10: 매도잔량\n- bidp_rsqn1~10: 매수잔량\n- antc_cnpr: 예상체결가"
          }
        }
      ]
    },

    {
      "name": "3. 계좌 (Account)",
      "item": [
        {
          "name": "주식잔고조회 (inquire-balance)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "{{tr_balance}}", "description": "real=TTTC8434R paper=VTTC8434R" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/trading/inquire-balance?CANO={{accountNo}}&ACNT_PRDT_CD={{accountProduct}}&AFHR_FLPR_YN=N&OFL_YN=&INQR_DVSN=02&UNPR_DVSN=01&FUND_STTL_ICLD_YN=N&FNCG_AMT_AUTO_RDPT_YN=N&PRCS_DVSN=00&CTX_AREA_FK100=&CTX_AREA_NK100=",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "trading", "inquire-balance"],
              "query": [
                { "key": "CANO",                  "value": "{{accountNo}}" },
                { "key": "ACNT_PRDT_CD",          "value": "{{accountProduct}}" },
                { "key": "AFHR_FLPR_YN",          "value": "N",  "description": "시간외단일가 반영 여부" },
                { "key": "OFL_YN",                "value": "" },
                { "key": "INQR_DVSN",             "value": "02", "description": "02=종목별 01=대출일별" },
                { "key": "UNPR_DVSN",             "value": "01" },
                { "key": "FUND_STTL_ICLD_YN",     "value": "N" },
                { "key": "FNCG_AMT_AUTO_RDPT_YN", "value": "N" },
                { "key": "PRCS_DVSN",             "value": "00", "description": "00=전일매매포함 01=미포함" },
                { "key": "CTX_AREA_FK100",        "value": "" },
                { "key": "CTX_AREA_NK100",        "value": "" }
              ]
            },
            "description": "TR_ID: TTTC8434R(실전) / VTTC8434R(모의)\n\n보유 종목 + 계좌 요약 조회.\n\noutput1: 보유 종목 리스트 (종목코드/평균단가/평가손익 등)\noutput2: 계좌 요약 1행 (예수금/평가금액/총평가금액 등)\n\n페이지 응답 헤더의 tr_cont='M' 이면 CTX_AREA_FK100/NK100 을 다음 요청에 포함."
          }
        },
        {
          "name": "매수가능조회 (inquire-psbl-order)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "{{tr_psblOrder}}", "description": "real=TTTC8908R paper=VTTC8908R" },
              { "key": "custtype",      "value": "P" }
            ],
            "url": {
              "raw": "{{baseUrl}}/uapi/domestic-stock/v1/trading/inquire-psbl-order?CANO={{accountNo}}&ACNT_PRDT_CD={{accountProduct}}&PDNO={{symbol}}&ORD_UNPR=0&ORD_DVSN=01&CMA_EVLU_AMT_ICLD_YN=N&OVRS_ICLD_YN=N",
              "host": ["{{baseUrl}}"],
              "path": ["uapi", "domestic-stock", "v1", "trading", "inquire-psbl-order"],
              "query": [
                { "key": "CANO",               "value": "{{accountNo}}" },
                { "key": "ACNT_PRDT_CD",       "value": "{{accountProduct}}" },
                { "key": "PDNO",               "value": "{{symbol}}", "description": "종목코드 (현금잔고만 필요시도 입력 필수)" },
                { "key": "ORD_UNPR",           "value": "0",          "description": "주문단가 (시장가=0)" },
                { "key": "ORD_DVSN",           "value": "01",         "description": "00=지정가 01=시장가" },
                { "key": "CMA_EVLU_AMT_ICLD_YN", "value": "N" },
                { "key": "OVRS_ICLD_YN",       "value": "N" }
              ]
            },
            "description": "TR_ID: TTTC8908R(실전) / VTTC8908R(모의)\n\n주요 응답 필드 (output):\n- ord_psbl_cash: 주문가능현금\n- nrcvb_buy_amt: 미수없는 매수금액\n- max_buy_amt: 최대매수금액\n- max_buy_qty: 최대매수수량\n- psbl_qty_calc_unpr: 가능수량 계산단가"
          }
        }
      ]
    },

    {
      "name": "4. 주문 — 국내주식 (Orders)",
      "item": [
        {
          "name": "매수주문 (order-cash BUY)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json; charset=utf-8" },
              { "key": "authorization", "value": "Bearer {{accessToken}}" },
              { "key": "appkey",        "value": "{{appKey}}" },
              { "key": "appsecret",     "value": "{{appSecret}}" },
              { "key": "tr_id",         "value": "{{tr_orderBuy}}", "description": "real=TTTC0802U paper=VTTC0802U" },
              { "key": "custtype",      "value": "P" },
              { "key": "hashkey",       "value": "", "description": "POST body 해시키 — /uapi/hashkey 로 생성" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CANO\": \"{{accountNo}}\",\n  \"ACNT_PRDT_CD\": \"{{accountProduct}}\",\n  \"PDNO\": \"{{symbol}}\",\n  \"ORD_DVSN\": \"01\",\n  \"ORD_QTY\": \"10\",\n  \"ORD_UNPR\": \"0\"\n}",
              "options": { "raw": { "language": "json" } }
