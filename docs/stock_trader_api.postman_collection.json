    {
      "name": "Collect — Daily Cron (비동기)",
      "description": "KIS + DART + FnGuide 복합 크론 수동 실행",
      "item": [
        {
          "name": "POST /collect/daily-cron — 전체 (KIS + DART + FnGuide)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 202) { pm.collectionVariables.set('jobId', pm.response.json().job_id); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 1,\n  \"skip_done\": true,\n  \"fetch_snapshot\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/daily-cron", "host": ["{{baseUrl}}"], "path": ["collect", "daily-cron"] },
