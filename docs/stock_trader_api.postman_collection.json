          }
        },
        {
          "name": "POST /collect/daily-cron — KIS만",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 202) { pm.collectionVariables.set('jobId', pm.response.json().job_id); }"],
