{
  "info": {
    "name": "Stock Trader API",
    "_postman_id": "stock-trader-api-v1",
    "description": "stock_trader FastAPI 전체 엔드포인트 모음.\n\n**사용 방법:**\n1. Collection Variables 에서 `baseUrl` 과 `apiKey` 를 설정하세요.\n   - baseUrl: http://localhost:8765 (일반/개발) 또는 http://localhost:8766 (GCP)\n   - apiKey: .env 의 STOCK_TRADER_API_KEY 값\n2. 인증이 필요한 엔드포인트는 `X-API-Key` 헤더를 자동으로 포함합니다.\n\n**비동기 엔드포인트:**\n- 202 Accepted 응답으로 job_id 를 반환합니다.\n- `GET /jobs/{job_id}` 로 진행 상황을 폴링하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8765",
      "description": "API 서버 주소. GCP 모드는 8766 으로 변경"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY_HERE",
      "description": ".env 의 STOCK_TRADER_API_KEY 값"
    },
    {
      "key": "jobId",
      "value": "",
      "description": "비동기 작업 제출 후 반환된 job_id (자동 설정됨)"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key",   "value": "X-API-Key",     "type": "string" },
      { "key": "value", "value": "{{apiKey}}",     "type": "string" },
      { "key": "in",    "value": "header",         "type": "string" }
    ]
  },
  "item": [

    {
      "name": "Health",
      "description": "서버 상태 확인 엔드포인트",
      "item": [
        {
          "name": "GET /health — 라이브니스 프로브 (인증 불필요)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "인증 없이 서버 생존 여부 확인. 로드밸런서/모니터링용."
          }
        },
        {
          "name": "GET /health/full — 상세 상태 (인증 필요)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health/full", "host": ["{{baseUrl}}"], "path": ["health", "full"] },
            "description": "DB 연결, 스케줄러 상태, 현재 실행 중인 수집기 목록 반환."
          }
        },
        {
          "name": "GET /health/debug-env — 환경변수 진단",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health/debug-env", "host": ["{{baseUrl}}"], "path": ["health", "debug-env"] },
            "description": "API 프로세스가 실제로 읽는 환경변수 확인. 시크릿은 길이만 표시."
          }
        }
      ]
    },

    {
      "name": "Jobs",
      "description": "비동기 잡 조회. 202 응답을 받은 후 job_id 로 폴링.",
      "item": [
        {
          "name": "GET /jobs — 잡 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "collector", "value": "",        "description": "수집기 이름 필터 (예: daily_kis, factor_eval). 미입력 시 전체", "disabled": true },
                { "key": "status",    "value": "running", "description": "상태 필터: pending | running | success | failed | rejected", "disabled": true },
                { "key": "limit",     "value": "20",      "description": "최대 반환 건수 (1~200, 기본 50)" }
              ]
            },
            "description": "최근 제출된 잡 목록. collector / status 로 필터 가능."
          }
        },
        {
          "name": "GET /jobs/{job_id} — 잡 상세",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            },
            "description": "특정 잡의 상태, 결과, 에러 확인. jobId 변수를 먼저 설정하세요."
          }
        }
      ]
    },

    {
      "name": "Schedule",
      "description": "APScheduler 잡 조회 및 일시정지/재개",
      "item": [
        {
          "name": "GET /schedule — 스케줄 목록",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/schedule", "host": ["{{baseUrl}}"], "path": ["schedule"] },
            "description": "등록된 크론 잡과 다음 실행 시각 조회."
          }
        },
        {
          "name": "POST /schedule/{job_id}/pause — 스케줄 일시정지",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/schedule/daily_kis_dart_cron/pause",
              "host": ["{{baseUrl}}"],
              "path": ["schedule", "daily_kis_dart_cron", "pause"]
            },
            "description": "스케줄 잡을 일시정지. job_id 값:\n- daily_kis_dart_cron\n- daily_hankyung_cron\n- weekly_factor_eval_cron"
          }
        },
        {
          "name": "POST /schedule/{job_id}/resume — 스케줄 재개",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/schedule/daily_kis_dart_cron/resume",
              "host": ["{{baseUrl}}"],
              "path": ["schedule", "daily_kis_dart_cron", "resume"]
            },
            "description": "일시정지된 스케줄 잡 재개."
          }
        }
      ]
    },

    {
      "name": "Collect — Master Data (동기)",
      "description": "빠르게 완료되는 마스터 데이터 수집. 응답에 결과 직접 포함.",
      "item": [
        {
          "name": "POST /collect/tickers/kr — 한국 종목 마스터 갱신",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desc\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/tickers/kr", "host": ["{{baseUrl}}"], "path": ["collect", "tickers", "kr"] },
            "description": "FinanceDataReader 에서 KRX 전체 종목 목록 갱신.\n- desc: 설명 컬럼 포함 여부"
          }
        },
        {
          "name": "POST /collect/tickers/us — 미국 종목 마스터 갱신",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/tickers/us", "host": ["{{baseUrl}}"], "path": ["collect", "tickers", "us"] },
            "description": "NASDAQ Trader 에서 미국 종목 목록 갱신."
          }
        },
        {
          "name": "POST /collect/dart/corp-codes — DART 법인코드 갱신",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force\": false,\n  \"stale_after_days\": 7\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/dart/corp-codes", "host": ["{{baseUrl}}"], "path": ["collect", "dart", "corp-codes"] },
            "description": "DART 법인 코드 갱신. stale_after_days 이내 수집이력 있으면 skip."
          }
        }
      ]
    },

    {
      "name": "Collect — Daily Prices (비동기)",
      "description": "일별 시세 수집. job_id 반환 → GET /jobs/{job_id} 로 폴링.",
      "item": [
        {
          "name": "POST /collect/daily/fdr — 한국 시세 (FinanceDataReader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 202) { pm.collectionVariables.set('jobId', pm.response.json().job_id); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 1,\n  \"skip_done\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/daily/fdr", "host": ["{{baseUrl}}"], "path": ["collect", "daily", "fdr"] },
            "description": "FinanceDataReader 경유 한국 전종목 일별 시세 수집.\n\n주요 파라미터:\n- days: 수집 일수 (end_date 기준 역산)\n- start_date / end_date: 명시적 날짜 범위 (YYYY-MM-DD)\n- symbols: 특정 종목만 (미입력 시 전체)\n- markets: [\"KOSPI\", \"KOSDAQ\"]\n- skip_done: 이미 수집된 날짜 건너뜀\n\n응답 job_id 가 자동으로 {{jobId}} 에 저장됩니다."
          }
        },
        {
          "name": "POST /collect/daily/kis — 한국 시세 (KIS API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 202) { pm.collectionVariables.set('jobId', pm.response.json().job_id); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 1,\n  \"skip_done\": true,\n  \"fetch_snapshot\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/daily/kis", "host": ["{{baseUrl}}"], "path": ["collect", "daily", "kis"] },
            "description": "KIS Open API 경유 한국 시세 수집. KIS_APP_KEY 등 자격증명 필요.\n- fetch_snapshot: 당일 스냅샷(실시간) 포함 여부"
          }
        },
        {
          "name": "POST /collect/daily/us — 미국 시세 (yfinance)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 202) { pm.collectionVariables.set('jobId', pm.response.json().job_id); }"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 1,\n  \"skip_done\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/daily/us", "host": ["{{baseUrl}}"], "path": ["collect", "daily", "us"] },
            "description": "yfinance 경유 미국 종목 일별 시세 수집.\n- exchanges: [\"NASDAQ\", \"NYSE\"]\n- security_types: [\"stock\", \"etf\"]"
          }
        }
      ]
    },

    {
      "name": "Collect — DART (비동기)",
