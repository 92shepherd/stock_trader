              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/collect/dart/indicators", "host": ["{{baseUrl}}"], "path": ["collect", "dart", "indicators"] },
            "description": "DART 재무비율 지표 수집 (ROE, ROA, 영업이익률 등). quality 팩터에 필요."
          }
        }
      ]
