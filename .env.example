# =============================================================================
# stock_trader environment variables (template)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this file (`.env.example`) is committed and must NEVER contain secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (TimescaleDB / PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockdata
DB_USER=stock
DB_PASSWORD=changeme_please


# -----------------------------------------------------------------------------
# KIS OpenAPI (한국투자증권)
# -----------------------------------------------------------------------------
# 1. Issue an app key at https://apiportal.koreainvestment.com
#    → [KIS Developers 서비스 신청]. Paper (모의) and Real (실전) keys are
#    issued separately — keep them in sync with KIS_MODE below.
# 2. Account must be a 종합매매계좌(위탁계좌). CMA accounts cannot trade
#    via this API.
# 3. Tokens are cached under data/kis/token_{paper|real}.json by src/kis/auth.py
#    so a 24h-valid token survives process restarts and respects KIS's
#    "1 issuance per minute" rate limit. Do not disable that cache.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT=01
# KIS_MODE: paper (모의투자, openapivts...:29443) or real (실전, openapi...:9443)
KIS_MODE=paper


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./data/logs


# -----------------------------------------------------------------------------
# KRX (pykrx 회원 로그인)
# -----------------------------------------------------------------------------
# Required by daily_pykrx.py since KRX moved to a membership model in early
# 2026 (pykrx>=1.1.1). Sign up at https://data.krx.co.kr/
KRX_ID=
KRX_PW=


# -----------------------------------------------------------------------------
# DART OpenAPI (전자공시시스템)
# -----------------------------------------------------------------------------
# Issue a key at https://opendart.fss.or.kr/ → 인증키 신청/관리
# Personal-use limit: 10,000 calls/day.
DART_API_KEY=


# -----------------------------------------------------------------------------
# FnGuide consensus scraper (개인용 비공개 한정)
# -----------------------------------------------------------------------------
# FnGuide(comp.fnguide.com) 컨센서스 페이지를 스크래핑하여 종목별 분기/연간
# 추정치를 수집한다. FnGuide 약관에는 데이터의 "데이터베이스화" 제한 조항이
# 있어, 본 컬렉터는 **개인 트레이딩 시스템의 비공개 사용 한정**으로만 운용
# 가능하다. 재배포 / 외부 공유 / 상업적 활용 금지.
#
# 이 정책을 인지하고 동의했음을 표시하려면 아래 값을 1 로 설정해야 한다.
# 값이 1 이 아니면 src/collectors/consensus_fnguide.py 가 RuntimeError 로
# 거부한다 (우발 실행 방지).
FNGUIDE_CONSENT_ACK=


# -----------------------------------------------------------------------------
# REST API (src.api) — collection trigger HTTP service
# -----------------------------------------------------------------------------
# Single-process FastAPI server with an in-process APScheduler. The API
# exposes triggers for every collector and the scheduler runs the daily
# 03:00 KST cron. Both share the SAME per-collector asyncio locks, so a
# manual API trigger cannot collide with the scheduled run.
#
# Auth model: every request must carry an `X-API-Key` header equal to
# STOCK_TRADER_API_KEY. Pick a long random string; keep it in .env only.
STOCK_TRADER_API_KEY=
# Bind address. Default is loopback-only — do NOT expose this on a public
# interface without putting a reverse proxy + real auth in front of it.
API_HOST=127.0.0.1
API_PORT=8765
# When true, register the default daily 03:00 KST KIS+DART schedule on
# startup (replaces the old `python -m src.main` cron). Set false if you
# only want manual API triggers.
SCHEDULER_ENABLED=true
# Cron expression for the default daily backfill. Defaults to 03:00 KST.
# Format: "MIN HOUR DAY MONTH DOW" (5-field, standard crontab).
SCHEDULER_DAILY_CRON=0 3 * * *
# Timezone for the scheduler. Korean market data → KST.
SCHEDULER_TIMEZONE=Asia/Seoul
